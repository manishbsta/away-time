{
  "name": "awaytime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "check": "python3 scripts/check_phase0.py",
    "prepare": "husky",
    "lint": "oxlint --deny-warnings src vite.config.ts lint-staged.config.js",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check src vite.config.ts lint-staged.config.js",
    "format": "prettier --write src vite.config.ts lint-staged.config.js",
    "format:rust:check": "cargo fmt --all -- --check"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "license": "GPL-3.0-only"
}
